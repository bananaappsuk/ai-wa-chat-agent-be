APP_ENV=dev
PORT=8000
SERVICE_NAME=ai-wa-chat-agent-api
MONGO_URI=mongodb://localhost:27017
MONGO_DB=ai_wa_chat_agent
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALG=HS256
JWT_EXPIRE_MIN=10080
CORS_ORIGINS=http://localhost:8080,https://your-fe.vercel.app
REDIS_URL=redis://localhost:6379/0
# Used for Twilio delivery status callbacks: {PUBLIC_BASE_URL}/api/webhook/twilio/status
# Leave empty locally to omit status_callback on outbound sends.
PUBLIC_BASE_URL=https://your-be.onrender.com

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional Messaging Service (MG...) — when set, used instead of TWILIO_WHATSAPP_FROM
TWILIO_MESSAGING_SERVICE_SID=
# Optional override; defaults to {PUBLIC_BASE_URL}/api/webhook/twilio/status
TWILIO_STATUS_CALLBACK_URL=
TWILIO_VALIDATE_SIGNATURE=true
TWILIO_VALIDATE_SIGNATURES=true
TRUSTED_PROXY_COUNT=1

# WhatsApp transport: twilio (default) | meta. Existing tenants stay on Twilio.
# Never route production traffic with this env var; stored tenant provider wins.
WHATSAPP_PROVIDER=twilio

# --- Meta WhatsApp Cloud API (server-side only). Never put these in VITE_* / Vercel. ---
# App-level production/staging (Render API). These are NOT tenant send credentials.
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
META_WEBHOOK_VALIDATE_SIGNATURE=true
META_HTTP_TIMEOUT_SECONDS=30
# AES-GCM key for per-tenant Meta tokens. 32 ascii chars or base64 of 16/24/32 bytes.
# Same value on API, worker, and scheduler. Must not equal JWT_SECRET.
META_TOKEN_ENCRYPTION_KEY=
# Facebook Login for Business Embedded Signup v4 configuration ID.
META_EMBEDDED_SIGNUP_CONFIG_ID=

# Legacy dev/test only — NOT production tenant credentials.
# Do not set these as production Graph send / routing / template-sync authority.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Dev/test only. Must stay false in staging/production. Never a silent production fallback.
META_ALLOW_LEGACY_POC_TOKEN=false

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_HISTORY=20
AI_FEATURES_ENABLED=true

MEDIA_STORAGE_DIR=media_uploads
MEDIA_MAX_BYTES=16777216

WORKER_JOB_TIMEOUT=300
WORKER_RESULT_TTL=500
WORKER_FAILURE_TTL=86400
RQ_QUEUE_NAME=default
RQ_HIGH_QUEUE_NAME=high
RQ_DEFAULT_QUEUE_NAME=default
RQ_BULK_QUEUE_NAME=bulk
# Optional: RQ_LISTEN_QUEUES=high,default,bulk

# Consent / STOP
WHATSAPP_OPTOUT_KEYWORDS=STOP,UNSUBSCRIBE,CANCEL,END,QUIT
WHATSAPP_OPTIN_KEYWORDS=START,YES,UNSTOP
WHATSAPP_ALLOW_KEYWORD_REOPTIN=true
WHATSAPP_OPTOUT_CONFIRMATION_ENABLED=true
WHATSAPP_OPTOUT_CONFIRMATION_TEXT=You have been unsubscribed and will not receive further marketing messages. Reply START to opt in again.

# Throughput
WHATSAPP_MESSAGES_PER_SECOND=5
WHATSAPP_MESSAGES_PER_MINUTE=200
WHATSAPP_MAX_CONCURRENT_SENDS=10
WHATSAPP_TENANT_MESSAGES_PER_MINUTE=60
WHATSAPP_QUEUE_MAX_DEPTH=5000

# Retries / idempotency / reconciliation
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_BASE_SECONDS=30
WHATSAPP_RETRY_MAX_SECONDS=900
WHATSAPP_RETRY_JITTER_SECONDS=15
IDEMPOTENCY_TTL_SECONDS=86400
MESSAGE_STALE_AFTER_MINUTES=60
RECONCILIATION_BATCH_SIZE=100

WEB_CONCURRENCY=1
WEB_TIMEOUT_SECONDS=120
KEEP_ALIVE_SECONDS=75
GRACEFUL_SHUTDOWN_SECONDS=30
# Local convenience only. Staging/production MUST be false + run `python scheduler.py`.
# If both inline and standalone schedulers run, campaigns can double-start.
RUN_INLINE_SCHEDULER=false
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_LOCK_KEY=scheduler:campaigns:lock
SCHEDULER_LOCK_TTL_SECONDS=120
CAMPAIGN_BATCH_SIZE=50
CAMPAIGN_MAX_RETRIES=3
CAMPAIGN_RETRY_BASE_SECONDS=30
LEAD_OPTIONS_MAX_LIMIT=200
MEDIA_STORAGE_BACKEND=local

LOG_LEVEL=INFO
LOG_FORMAT=
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0
# When true, METRICS_TOKEN is required (empty token never opens /metrics).
METRICS_ENABLED=false
METRICS_TOKEN=

MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000
REDIS_CONNECT_TIMEOUT_SECONDS=10
REDIS_SOCKET_TIMEOUT_SECONDS=30

RATE_LIMIT_AUTH_PER_IP=20
RATE_LIMIT_AUTH_WINDOW_SEC=60
RATE_LIMIT_SEND_PER_USER=120
RATE_LIMIT_UPLOAD_PER_USER=30
RATE_LIMIT_CAMPAIGN_PER_USER=20
RATE_LIMIT_WEBHOOK_PER_IP=600
RATE_LIMIT_STATUS_CALLBACK_PER_IP=2000

LEAD_IMPORT_MAX_FILE_MB=5
LEAD_IMPORT_MAX_ROWS=5000
LEAD_IMPORT_BATCH_SIZE=200
LEAD_IMPORT_MAX_ERRORS_RETURNED=50
LEAD_EXPORT_MAX_ROWS=10000
LEAD_BULK_MAX_ITEMS=200
LEAD_LIST_DEFAULT_PAGE_SIZE=25
LEAD_LIST_MAX_PAGE_SIZE=100

# Password reset / email (E7)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_RESET_FRONTEND_URL=http://localhost:8080/reset-password
PASSWORD_RESET_RATE_LIMIT=5
PASSWORD_RESET_EMAIL_ENABLED=false
EMAIL_PROVIDER=log
EMAIL_FROM=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SENDGRID_API_KEY=
AVATAR_MAX_BYTES=2097152

# AI (C6–C17)
OPENAI_FALLBACK_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.5
OPENAI_MAX_OUTPUT_TOKENS=400
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=2
AI_ALLOWED_MODELS=gpt-4o-mini,gpt-4o,gpt-4.1-mini,gpt-4.1
AI_SUMMARIES_ENABLED=true
AI_EXTRACTION_ENABLED=true
AI_MODERATION_ENABLED=true
AI_ANALYTICS_ENABLED=true
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONTEXT_CHARS=12000
AI_DAILY_TOKEN_LIMIT_PER_TENANT=200000
AI_MONTHLY_COST_LIMIT_PER_TENANT=50
AI_MAX_REQUESTS_PER_MINUTE_PER_TENANT=30
AI_SUMMARY_TRIGGER_MESSAGE_COUNT=8
AI_AUTO_ESCALATE_URGENT=true
AI_AUTO_ESCALATE_NEGATIVE=false
AI_FAILURE_FALLBACK_ENABLED=true
AI_FAILURE_MARK_NEEDS_HUMAN=true

# Stripe billing — dual test/live (preferred)
# STRIPE_MODE=test|live  (empty: production→live, else test)
STRIPE_MODE=test
STRIPE_ALLOW_LIVE_IN_DEV=false
FRONTEND_BASE_URL=http://localhost:8080

STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
STRIPE_TEST_WEBHOOK_SECRET=whsec_...
STRIPE_TEST_PRICE_STARTER=price_...
STRIPE_TEST_PRICE_PROFESSIONAL=price_...
STRIPE_TEST_PRICE_BUSINESS=price_...

STRIPE_LIVE_SECRET_KEY=sk_live_...
STRIPE_LIVE_PUBLISHABLE_KEY=pk_live_...
STRIPE_LIVE_WEBHOOK_SECRET=whsec_...
STRIPE_LIVE_PRICE_STARTER=price_...
STRIPE_LIVE_PRICE_PROFESSIONAL=price_...
STRIPE_LIVE_PRICE_BUSINESS=price_...

# Deprecated single-slot fallbacks (still work; migrate to STRIPE_TEST_* / STRIPE_LIVE_*)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# STRIPE_PRICE_BUSINESS=price_...

STRIPE_SUCCESS_URL=http://localhost:8080/billing?checkout=success
STRIPE_CANCEL_URL=http://localhost:8080/billing?checkout=canceled
STRIPE_PORTAL_RETURN_URL=http://localhost:8080/billing
STRIPE_TRIAL_DAYS=14
STRIPE_CUSTOMER_LOCK_TTL_SECONDS=60
STRIPE_WEBHOOK_CLAIM_TTL_SECONDS=300
BILLING_CONTACT_SALES_URL=https://calendar.google.com/calendar/u/0/appointments/schedules/AcZssZ0qcRUglD8qicU4kzrD-rFtlyP94h0JaZnv_-41rtPM-BkStaGx-mBvWG0nOP8EzQzaaMgYk8Qm

# Production example (do not use localhost / tunnels):
# STRIPE_MODE=live
# FRONTEND_BASE_URL=https://app.example.com
# STRIPE_SUCCESS_URL=https://app.example.com/billing?checkout=success
# STRIPE_CANCEL_URL=https://app.example.com/billing?checkout=cancelled
# STRIPE_PORTAL_RETURN_URL=https://app.example.com/billing
# PUBLIC_BASE_URL=https://api.example.com
